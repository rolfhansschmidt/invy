# Generate ADMIN_PASSWORD and SESSION_SECRET independently, e.g.:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PUBLIC_URL=https://inventory.clankpilot.top
SESSION_COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-24-characters
SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
SESSION_HOURS=8
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW=900
INVY_UID=1000
INVY_GID=1000
INVY_PORT=8102
INVY_BIND_ADDRESS=127.0.0.1
# Copy the exact issuer shown in the Authentik discovery document.
OIDC_ISSUER_URL=https://auth.example.com/application/o/invy/
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/invy/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-with-authentik-client-id
OIDC_CLIENT_SECRET=replace-with-authentik-client-secret
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
# Empty = all users authorized by the provider. Otherwise comma-separated groups.
OIDC_ALLOWED_GROUPS=
OIDC_TOKEN_AUTH_METHOD=client_secret_basic

INVY_MEMORY_LIMIT=512m
INVY_CPUS=1.0
INVY_PIDS_LIMIT=128
